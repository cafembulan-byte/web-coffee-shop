# ENVIRONMENT VARIABLES TEMPLATE
# Copy file ini menjadi .env atau isi langsung di app.js

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
# Get these from Firebase Console → Project Settings → Your Apps → Web App

FIREBASE_API_KEY=AIzaSyD...
FIREBASE_PROJECT_ID=kedai-kopi-xxxxx
FIREBASE_STORAGE_BUCKET=kedai-kopi-xxxxx.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from Supabase Dashboard → Settings → API

SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# DATABASE SELECTION
# ============================================================================
# Options: 'firebase' or 'supabase'

DB_TYPE=firebase

# ============================================================================
# GOOGLE MAPS
# ============================================================================
# Your business location link from Google Maps

GOOGLE_MAPS_LINK=https://maps.google.com/?q=kedai+kopi+anda

# ============================================================================
# OPTIONAL: ANALYTICS & TRACKING
# ============================================================================

GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=123456789012345

# ============================================================================
# NOTES:
# - JANGAN commit file .env ke Git!
# - Add .env ke .gitignore
# - Di production: Set environment variables di server
# - Di cPanel: Isi langsung di app.js (client-side)
